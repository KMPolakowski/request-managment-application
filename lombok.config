# This is the root of the project; do not look for further configuration above it.
config.stopBubbling = true

# Mark generated members with @lombok.Generated so JaCoCo leaves them out of the coverage figures:
# generated accessors are not behaviour and should not flatter, or drag down, the coverage gate.
lombok.addLombokGeneratedAnnotation = true

# Generated code is not ours to document.
lombok.extern.findbugs.addSuppressFBWarnings = false
